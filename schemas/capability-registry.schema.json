{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-os.dev/schemas/capability-registry.schema.json",
  "title": "AION Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_behavior", "capabilities"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"const": "1.0"},
    "default_behavior": {"const": "deny"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "resource_pattern",
        "environments",
        "data_classifications",
        "default_ttl_seconds",
        "max_uses",
        "transferable",
        "requires_human_approval"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[^\\s]+$"},
        "description": {"type": "string", "maxLength": 512},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "resource_pattern": {"type": "string", "minLength": 1, "maxLength": 1024},
        "environments": {
          "type": "array",
          "items": {"enum": ["simulation", "lab", "staging", "host"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "data_classifications": {
          "type": "array",
          "items": {"enum": ["public", "internal", "confidential", "restricted"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "default_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_uses": {"type": "integer", "minimum": 1, "maximum": 1000},
        "transferable": {"const": false},
        "requires_human_approval": {"type": "boolean"},
        "network_destinations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 253},
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    }
  }
}
