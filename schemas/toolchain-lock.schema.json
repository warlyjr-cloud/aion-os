{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-os.dev/schemas/toolchain-lock.schema.json",
  "title": "AION Toolchain Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "development", "security"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"const": "1.0"},
    "runtime": {"$ref": "#/$defs/toolMap"},
    "development": {"$ref": "#/$defs/toolMap"},
    "security": {"$ref": "#/$defs/toolMap"}
  },
  "$defs": {
    "toolMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "source"],
        "properties": {
          "constraint": {"type": "string", "minLength": 1, "maxLength": 128},
          "source": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
