{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-os.dev/schemas/audit-event.schema.json",
  "title": "AION Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "event_type",
    "actor",
    "objective_id",
    "mutation_id",
    "details",
    "previous_hash",
    "event_hash"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective_id": {"type": ["string", "null"], "maxLength": 128},
    "mutation_id": {"type": ["string", "null"], "maxLength": 128},
    "details": {"type": "object"},
    "previous_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
