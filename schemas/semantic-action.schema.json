{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-os.dev/schemas/semantic-action.schema.json",
  "title": "AION Semantic Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "action_type",
    "target",
    "reason",
    "origin",
    "objective_id",
    "required_capability",
    "risk_tier",
    "inputs",
    "expected_result",
    "timeout_seconds",
    "resource_limits",
    "network_policy",
    "rollback_action"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "action_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "action_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "target": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason": {"type": "string", "minLength": 3, "maxLength": 1000},
    "origin": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "required_capability": {"type": "string", "minLength": 3, "maxLength": 512},
    "risk_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "inputs": {"type": "object"},
    "expected_result": {"type": "string", "minLength": 1, "maxLength": 512},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 30},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_seconds", "memory_mb", "output_bytes"],
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 30},
        "memory_mb": {"type": "integer", "minimum": 16, "maximum": 4096, "default": 256},
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000,
          "default": 1000000
        }
      }
    },
    "network_policy": {"enum": ["deny", "allowlisted"], "default": "deny"},
    "rollback_action": {"type": "string", "minLength": 3, "maxLength": 512}
  }
}
